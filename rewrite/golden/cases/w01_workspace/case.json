{
  "description": "Three repositories (one with its own configuration, one with no commits), two excluded by request.",
  "mode": "workspace",
  "args": [
    "--workspace",
    "{ROOT}",
    "--out",
    "{OUT}",
    "--exclude-repo",
    "study"
  ],
  "git": [
    "public/alpha",
    "private/beta"
  ],
  "fake_repositories": [
    "gamma",
    "study/borrowed",
    "study/cloned"
  ],
  "artifacts": [
    {
      "actual": "{OUT}/workspace.json",
      "expected": "workspace.json"
    },
    {
      "actual": "{OUT}/repos/public/alpha/index.json",
      "expected": "repos/public/alpha/index.json"
    },
    {
      "actual": "{OUT}/repos/private/beta/index.json",
      "expected": "repos/private/beta/index.json"
    },
    {
      "actual": "{OUT}/repos/gamma/index.json",
      "expected": "repos/gamma/index.json"
    }
  ]
}
